{
    // See https://code.visualstudio.com/docs/editor/debugging
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PPX: Debug Governance Baseline",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/tools/agent-governance-baseline/Debug-GovernanceBaseline.ps1",
            "args": [ "-Verbose" ],
            "cwd": "${workspaceFolder}/tools/agent-governance-baseline"
        },
        {
            "name": "PPX: Debug Custom Connector Usage",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/tools/custom-connector-usage/Debug-CustomConnectorUsage.ps1",
            "args": [ "-Verbose", "-MaxPages", "1" ],
            "cwd": "${workspaceFolder}/tools/custom-connector-usage"
        },
        {
            // DRY RUN by default (no -Apply): reads every environment and writes the report, never
            // changes anything. Add "-Apply" to args to exercise the write path.
            "name": "PPX: Debug Copilot Credit Tenant Pool",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/tools/copilot-credit-tenant-pool/Debug-CopilotCreditTenantPool.ps1",
            "args": [ "-Verbose", "-DrawFromTenantCapacity", "$false", "-AllEnvironments" ],
            "cwd": "${workspaceFolder}/tools/copilot-credit-tenant-pool"
        },
        {
            // Generic fallback: run whatever .ps1 is in the active editor.
            // Only useful for scripts that actually invoke something at top level.
            "name": "PowerShell: Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "cwd": "${fileDirname}"
        },
        {
            // Attach breakpoints, F5 this, then call functions by hand in the
            // PowerShell Integrated Console (e.g. after dot-sourcing a file).
            "name": "PowerShell: Interactive Session",
            "type": "PowerShell",
            "request": "launch",
            "cwd": "${workspaceFolder}"
        }
    ]
}
